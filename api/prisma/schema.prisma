generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserStatus {
  pending
  active
  suspended
}

enum Sex {
  male
  female
}

enum MemberStatus {
  pending
  active
  inactive
  graduated
  transferred
}

enum CourseStatus {
  draft
  open
  closed
  archived
}

enum MediaType {
  text
  pdf
  audio
  video
  link
}

enum EnrollmentStatus {
  active
  completed
  dropped
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum AttendanceSessionStatus {
  open
  closed
}

enum PostType {
  sinksar
  bible_reading
  saint_of_day
  urgent
  event
  news
  teaching
}

enum EventRsvpStatus {
  going
  maybe
  not_going
}

enum FormStatus {
  draft
  open
  closed
}

enum FormResponseStatus {
  submitted
  approved
  rejected
}

enum DevicePlatform {
  android
  ios
  web
}

enum PaymentMethod {
  telebirr
  cbe
  abyssinia
  awash
  dashen
  other_bank
  cash
}

enum PaymentStatus {
  pending
  approved
  rejected
}

// -------------------------------------------------------------
// 1. AUTH & ROLES
// -------------------------------------------------------------

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id              String     @id @default(uuid()) @db.Char(36)
  email           String?    @unique @db.VarChar(191)
  phone           String?    @unique @db.VarChar(50)
  passwordHash    String     @db.VarChar(255)
  roleId          Int
  status          UserStatus @default(pending)
  twoFactorSecret String?    @db.VarChar(255)
  failedLogins    Int        @default(0)
  lockedUntil     DateTime?
  lastLogin       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  role             Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  member           Member?
  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  settingVersions  SettingVersion[]
  reviewedPayments MembershipPayment[] @relation("ReviewedPayments")
  createdPages     Page[]              @relation("PageCreator")
  updatedPages     Page[]              @relation("PageUpdater")
  pageVersions     PageVersion[]       @relation("PageVersionUser")
  uploadedMedia    MediaAsset[]        @relation("MediaAssetUploader")

  @@index([roleId])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @db.Char(36)
  tokenHash String   @db.VarChar(255)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// -------------------------------------------------------------
// 2. DEPARTMENTS & MEMBERS
// -------------------------------------------------------------

model Department {
  id          Int      @id @default(autoincrement())
  nameAm      String   @unique @db.VarChar(100)
  nameEn      String?  @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members Member[]

  @@map("departments")
}

model Member {
  id               String       @id @default(uuid()) @db.Char(36)
  memberNo         String       @unique @db.VarChar(50)
  userId           String?      @unique @db.Char(36)
  firstName        String       @db.VarChar(100)
  fatherName       String       @db.VarChar(100)
  grandfatherName  String?      @db.VarChar(100)
  baptismalName    String?      @db.VarChar(100)
  sex              Sex
  dateOfBirth      DateTime?
  phone            String?      @db.VarChar(50)
  email            String?      @db.VarChar(191)
  region           String?      @db.VarChar(100)
  zone             String?      @db.VarChar(100)
  woreda           String?      @db.VarChar(100)
  kebele           String?      @db.VarChar(100)
  addressDetail    String?      @db.Text
  parish           String?      @db.VarChar(191)
  confessionFather String?      @db.VarChar(191)
  educationLevel   String?      @db.VarChar(100)
  occupation       String?      @db.VarChar(100)
  emergencyName    String?      @db.VarChar(100)
  emergencyPhone   String?      @db.VarChar(50)
  departmentId     Int?
  photoUrl         String?      @db.VarChar(500)
  status           MemberStatus @default(active)
  joinedAt         DateTime     @default(now())
  notes            String?      @db.Text
  customFields     Json?
  createdBy        String?      @db.Char(36)
  deletedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  enrollments        Enrollment[]
  attendances        Attendance[]
  certificates       Certificate[]
  favorites          Favorite[]
  eventRsvps         EventRsvp[]
  formResponses      FormResponse[]
  contributions      Contribution[]
  membershipPayments MembershipPayment[]

  @@index([departmentId])
  @@index([status])
  @@index([phone])
  @@index([deletedAt])
  @@fulltext([firstName, fatherName, grandfatherName, baptismalName])
  @@map("members")
}

// -------------------------------------------------------------
// 3. ACADEMIC (COURSES, LESSONS, ATTENDANCE, GRADES, CERTIFICATES)
// -------------------------------------------------------------

model Course {
  id          String       @id @default(uuid()) @db.Char(36)
  titleAm     String       @db.VarChar(200)
  titleEn     String?      @db.VarChar(200)
  description String?      @db.Text
  level       String?      @db.VarChar(50)
  teacherId   String?      @db.Char(36)
  schedule    String?      @db.VarChar(200)
  capacity    Int?
  startDate   DateTime?
  endDate     DateTime?
  status      CourseStatus @default(draft)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lessons            Lesson[]
  enrollments        Enrollment[]
  attendances        Attendance[]
  attendanceSessions AttendanceSession[]
  certificates       Certificate[]

  @@index([status])
  @@index([teacherId])
  @@map("courses")
}

model Lesson {
  id        String    @id @default(uuid()) @db.Char(36)
  courseId  String    @db.Char(36)
  title     String    @db.VarChar(200)
  content   String?   @db.LongText
  mediaType MediaType @default(text)
  fileUrl   String?   @db.VarChar(500)
  orderNo   Int       @default(1)
  published Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([orderNo])
  @@map("lessons")
}

model Enrollment {
  id        String           @id @default(uuid()) @db.Char(36)
  memberId  String           @db.Char(36)
  courseId  String           @db.Char(36)
  status    EnrollmentStatus @default(active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  member Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grades Grade[]

  @@unique([memberId, courseId])
  @@index([memberId])
  @@index([courseId])
  @@index([status])
  @@map("enrollments")
}

model AttendanceSession {
  id          String                  @id @default(uuid()) @db.Char(36)
  sessionDate DateTime                @db.Date
  title       String                  @db.VarChar(200)
  courseId    String?                 @db.Char(36)
  status      AttendanceSessionStatus @default(open)
  openedBy    String                  @db.Char(36)
  closedAt    DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  course      Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  attendances Attendance[]

  @@index([sessionDate])
  @@index([courseId])
  @@index([status])
  @@map("attendance_sessions")
}

model Attendance {
  id          String           @id @default(uuid()) @db.Char(36)
  sessionId   String?          @db.Char(36)
  memberId    String           @db.Char(36)
  courseId    String?          @db.Char(36)
  sessionDate DateTime         @db.Date
  status      AttendanceStatus @default(present)
  markedBy    String?          @db.Char(36)
  notes       String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  session AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member  Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  course  Course?            @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([sessionId, memberId])
  @@index([sessionId])
  @@index([memberId])
  @@index([courseId])
  @@index([sessionDate])
  @@map("attendances")
}

model Grade {
  id           String   @id @default(uuid()) @db.Char(36)
  enrollmentId String   @db.Char(36)
  assessment   String   @db.VarChar(100)
  score        Float
  maxScore     Float    @default(100)
  remark       String?  @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@map("grades")
}

model Certificate {
  id        String   @id @default(uuid()) @db.Char(36)
  memberId  String   @db.Char(36)
  courseId  String   @db.Char(36)
  code      String   @unique @db.VarChar(100)
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([courseId])
  @@map("certificates")
}

// -------------------------------------------------------------
// 4. MEZMUR & CATEGORIES
// -------------------------------------------------------------

model MezmurCategory {
  id        Int      @id @default(autoincrement())
  nameAm    String   @unique @db.VarChar(100)
  nameEn    String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mezmurs Mezmur[]

  @@map("mezmur_categories")
}

model Mezmur {
  id         String   @id @default(uuid()) @db.Char(36)
  title      String   @db.VarChar(255)
  lyrics     String?  @db.LongText
  categoryId Int?
  singer     String?  @db.VarChar(150)
  audioUrl   String?  @db.VarChar(500)
  videoUrl   String?  @db.VarChar(500)
  isPublic   Boolean  @default(true)
  createdBy  String?  @db.Char(36)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category  MezmurCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  favorites Favorite[]

  @@index([categoryId])
  @@index([isPublic])
  @@fulltext([title, lyrics])
  @@map("mezmurs")
}

model Favorite {
  memberId  String   @db.Char(36)
  mezmurId  String   @db.Char(36)
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mezmur Mezmur @relation(fields: [mezmurId], references: [id], onDelete: Cascade)

  @@id([memberId, mezmurId])
  @@index([memberId])
  @@index([mezmurId])
  @@map("favorites")
}

// -------------------------------------------------------------
// 5. POSTS & EVENTS
// -------------------------------------------------------------

model Post {
  id        String    @id @default(uuid()) @db.Char(36)
  type      PostType  @default(news)
  title     String    @db.VarChar(255)
  body      String    @db.LongText
  imageUrl  String?   @db.VarChar(500)
  isUrgent  Boolean   @default(false)
  publishAt DateTime  @default(now())
  expiresAt DateTime?
  authorId  String?   @db.Char(36)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type])
  @@index([isUrgent])
  @@index([publishAt])
  @@index([authorId])
  @@map("posts")
}

model Event {
  id          String    @id @default(uuid()) @db.Char(36)
  title       String    @db.VarChar(255)
  description String?   @db.Text
  location    String?   @db.VarChar(255)
  startAt     DateTime
  endAt       DateTime?
  capacity    Int?
  createdBy   String?   @db.Char(36)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rsvps EventRsvp[]

  @@index([startAt])
  @@index([createdBy])
  @@map("events")
}

model EventRsvp {
  eventId   String          @db.Char(36)
  memberId  String          @db.Char(36)
  status    EventRsvpStatus @default(going)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
  @@map("event_rsvps")
}

// -------------------------------------------------------------
// 6. FORMS & RESPONSES
// -------------------------------------------------------------

model Form {
  id                        String     @id @default(uuid()) @db.Char(36)
  title                     String     @db.VarChar(255)
  description               String?    @db.Text
  formSchema                Json
  status                    FormStatus @default(draft)
  openUntil                 DateTime?
  allowOneResponsePerMember Boolean    @default(false)
  createdBy                 String?    @db.Char(36)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  responses FormResponse[]

  @@index([status])
  @@index([openUntil])
  @@map("forms")
}

model FormResponse {
  id          String             @id @default(uuid()) @db.Char(36)
  formId      String             @db.Char(36)
  memberId    String?            @db.Char(36)
  answers     Json
  status      FormResponseStatus @default(submitted)
  reviewNote  String?            @db.Text
  reviewedBy  String?            @db.Char(36)
  submittedAt DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  form   Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([formId])
  @@index([memberId])
  @@index([status])
  @@map("form_responses")
}

// -------------------------------------------------------------
// 7. FINANCE & SYSTEM
// -------------------------------------------------------------

model Contribution {
  id            String   @id @default(uuid()) @db.Char(36)
  memberId      String   @db.Char(36)
  amount        Decimal  @db.Decimal(12, 2)
  type          String   @db.VarChar(50)
  paymentMethod String?  @db.VarChar(50)
  period        String?  @db.VarChar(50)
  receiptNo     String?  @unique @db.VarChar(100)
  notes         String?  @db.Text
  paidAt        DateTime @default(now())
  recordedBy    String?  @db.Char(36)
  createdAt     DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([type])
  @@index([paidAt])
  @@map("contributions")
}

model Notification {
  id     String    @id @default(uuid()) @db.Char(36)
  userId String    @db.Char(36)
  title  String    @db.VarChar(255)
  body   String?   @db.Text
  data   Json?
  sentAt DateTime  @default(now())
  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sentAt])
  @@index([readAt])
  @@map("notifications")
}

model DeviceToken {
  id        String         @id @default(uuid()) @db.Char(36)
  userId    String         @db.Char(36)
  token     String         @unique @db.VarChar(500)
  platform  DevicePlatform @default(web)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@map("device_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @db.Char(36)
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @db.VarChar(100)
  oldValue  Json?
  newValue  Json?
  ip        String?  @db.VarChar(50)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  settingKey   String   @id @db.VarChar(100)
  settingValue Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("settings")
}

model SettingVersion {
  id           String   @id @default(uuid()) @db.Char(36)
  settingKey   String   @db.VarChar(100)
  settingValue Json
  changedBy    String?  @db.Char(36)
  changeReason String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([settingKey, createdAt])
  @@index([changedBy])
  @@map("setting_versions")
}

// -------------------------------------------------------------
// 8. ANNUAL MEMBERSHIP PAYMENTS
// -------------------------------------------------------------

model MembershipPayment {
  id             String        @id @default(uuid()) @db.Char(36)
  memberId       String        @db.Char(36)
  membershipYear Int           @default(2018)
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("ETB") @db.VarChar(10)
  method         PaymentMethod
  referenceNo    String        @db.VarChar(100)
  paidOn         DateTime
  proofUrl       String?       @db.VarChar(500)
  status         PaymentStatus @default(pending)
  reviewedBy     String?       @db.Char(36)
  reviewedAt     DateTime?
  reviewNote     String?       @db.Text
  receiptNo      String?       @unique @db.VarChar(100)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("ReviewedPayments", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([method, referenceNo])
  @@index([memberId])
  @@index([membershipYear])
  @@index([status])
  @@index([paidOn])
  @@map("membership_payments")
}

// -------------------------------------------------------------
// 9. CMS & PAGE BUILDER
// -------------------------------------------------------------

enum PageStatus {
  draft
  scheduled
  published
}

enum SectionAudience {
  everyone
  guests
  members
  staff
}

enum MenuLocation {
  header
  footer
}

enum MediaAssetKind {
  image
  audio
  video
  pdf
}

model Page {
  id        String     @id @default(uuid()) @db.Char(36)
  slug      String     @unique @db.VarChar(191)
  titleAm   String     @db.VarChar(255)
  titleEn   String     @db.VarChar(255)
  status    PageStatus @default(draft)
  publishAt DateTime?
  seo       Json?
  isSystem  Boolean    @default(false)
  version   Int        @default(1)
  createdBy String?    @db.Char(36)
  updatedBy String?    @db.Char(36)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sections PageSection[]
  versions PageVersion[]
  creator  User?         @relation("PageCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  updater  User?         @relation("PageUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([status, publishAt])
  @@index([createdBy])
  @@map("cms_pages")
}

model PageSection {
  id        String          @id @default(uuid()) @db.Char(36)
  pageId    String          @db.Char(36)
  type      String          @db.VarChar(100)
  orderNo   Int             @default(0)
  visible   Boolean         @default(true)
  content   Json
  config    Json
  style     Json
  audience  SectionAudience @default(everyone)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, orderNo])
  @@map("cms_page_sections")
}

model PageVersion {
  id        String   @id @default(uuid()) @db.Char(36)
  pageId    String   @db.Char(36)
  version   Int      @default(1)
  snapshot  Json
  note      String?  @db.VarChar(255)
  createdBy String?  @db.Char(36)
  createdAt DateTime @default(now())

  page Page  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User? @relation("PageVersionUser", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  @@map("cms_page_versions")
}

model Menu {
  id        String       @id @default(uuid()) @db.Char(36)
  location  MenuLocation @unique
  items     Json
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("cms_menus")
}

model MediaAsset {
  id         String         @id @default(uuid()) @db.Char(36)
  url        String         @db.VarChar(500)
  kind       MediaAssetKind @default(image)
  altAm      String         @default("") @db.VarChar(255)
  altEn      String         @default("") @db.VarChar(255)
  width      Int?
  height     Int?
  sizeBytes  Int            @default(0)
  folder     String         @default("general") @db.VarChar(100)
  mimeType   String?        @db.VarChar(100)
  uploadedBy String?        @db.Char(36)
  createdAt  DateTime       @default(now())

  uploader User? @relation("MediaAssetUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@index([folder])
  @@index([kind])
  @@map("cms_media_assets")
}

model UiString {
  id        String   @id @default(uuid()) @db.Char(36)
  key       String   @unique @db.VarChar(191)
  group     String   @db.VarChar(100)
  am        String   @db.Text
  en        String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("cms_ui_strings")
}

model FormConfig {
  id        String   @id @default(uuid()) @db.Char(36)
  formKey   String   @unique @db.VarChar(100)
  titleAm   String?  @db.VarChar(255)
  titleEn   String?  @db.VarChar(255)
  fields    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_form_configs")
}
