NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001
ENABLE_SWAGGER=true

# Database (MySQL 8 / MariaDB)
DATABASE_URL=mysql://db_user:db_password@localhost:3306/aemade_selam?charset=utf8mb4

# Authentication Secrets (minimum 32 random characters)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_min_32_chars

# Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ChangeMeOnFirstLogin123!

# Storage & Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Optional Monitoring & S3 Backups
SENTRY_DSN=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=af-south-1
