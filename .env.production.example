# ==============================================================================
# Aemade Selam Sunday School Management System
# Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System & Domain Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
DOMAIN_NAME=aemade.org
LETSENCRYPT_EMAIL=admin@aemade.org

# ------------------------------------------------------------------------------
# 2. Database (MySQL 8.0 utf8mb4)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=ChangeThisToStrongRootPassword_123!
MYSQL_DATABASE=aemade_selam
MYSQL_USER=aemade_user
MYSQL_PASSWORD=ChangeThisToStrongUserPassword_456!

# Database connection string used by Prisma inside containers
DATABASE_URL="mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}?charset=utf8mb4"

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Cryptography
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=d3d3LmFlbWFkZS5vcmdfc3VwZXJfc2VjcmV0X2tleV9mb3Jfand0X3NpZ25pbmdfYXV0aF8yMDI2
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# 4. Super Admin Credentials (Created on first run if missing)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@aemade.org
SUPER_ADMIN_PASSWORD=ChangeMeImmediately_Admin@2026!
RESET_SUPER_ADMIN=false

# ------------------------------------------------------------------------------
# 5. Monitoring & Error Tracking (Sentry)
# ------------------------------------------------------------------------------
# Backend Sentry DSN
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Frontend Next.js Public Sentry DSN
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# 6. Storage & Automated Backups
# ------------------------------------------------------------------------------
BACKUP_STORAGE_PATH=/app/backups
BACKUP_RETENTION_DAYS=30

# Off-site Cloud Backup (AWS S3 / Cloudflare R2 / MinIO)
S3_BACKUP_ENABLED=false
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_BUCKET=aemade-selam-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ------------------------------------------------------------------------------
# 7. Email Service (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@aemade.org
SMTP_PASS=
SMTP_FROM="አዕማደ ሰላም ሰንበት ት/ቤት <noreply@aemade.org>"

# ------------------------------------------------------------------------------
# 8. SMS & Telegram Notifications (Optional Gateways)
# ------------------------------------------------------------------------------
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
TELEGRAM_BOT_TOKEN=
